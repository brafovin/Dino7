{
  "name": "apex-grand-prix",
  "version": "1.0.0",
  "private": true,
  "description": "Browserbasiertes 3D-Formel-Rennspiel mit Fahrphysik, KI-Gegnern und Online-Multiplayer",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx tests/sim.test.ts && tsx tests/multiplayer.test.ts",
    "test:sim": "tsx tests/sim.test.ts",
    "test:mp": "tsx tests/multiplayer.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "concurrently": "9.1.0",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "6.4.4"
  }
}
